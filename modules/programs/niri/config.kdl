input {
    keyboard {
        xkb {
            layout "ie"
        }
        repeat-delay 200
        repeat-rate 35
        numlock
    }
    touchpad {
        tap
        natural-scroll
    }
}

prefer-no-csd

blur {
    passes 3
    offset 3
    noise 0.02
    saturation 1.5
}

layout {
    focus-ring {
        // off
    }

}

window-rule {
    match app-id="^Alacritty$"

    draw-border-with-background false
}

layer-rule {
    match layer="bottom"
    match layer="top"
    match layer="overlay"

    background-effect {
        blur true
    }

}

